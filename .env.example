# ─────────── Telegram ───────────
BOT_TOKEN=

# ─────────── АДМИН ───────────
ADMIN_ID=
ADMIN_SECRET=замени-меня-сразу

# ─────────── Прокси ───────────
PROXY_URL=

# ─────────── Распознавание ───────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=auto
# VAD filter: фильтрует тишину. Выключи (false) если часто слушаешь музыку
WHISPER_VAD_FILTER=true

# ─────────── LLM ───────────
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# ─────────── Лимиты ───────────
FREE_MONTHLY_LIMIT=3
FREE_MAX_MINUTES=15
PRO_TRIAL_HOURS=24
